  {
    "type": "function",
    "persona": "legal_uk",
    "function": {
      "name": "parliament_get_debate_divisions",
      "description": "Fetch the formal votes (divisions) held within a debate. An empty list is the honest, common result — most debates have no vote. Each division carries a votes_id usable with votes_get_division for the full member-by-member record.",
      "parameters": {
        "type": "object",
        "properties": {
          "debate_ext_id": {
            "type": "string",
            "description": "Debate GUID, chained from parliament_search_hansard or parliament_policy_position_summary results"
          }
        },
        "required": [
          "debate_ext_id"
        ]
      }
    }
  },
  {
    "type": "function",
    "persona": "legal_uk",
    "function": {
      "name": "parliament_get_debate_contributions",
      "description": "Fetch verbatim contributions from a debate, optionally filtered to one member by member_id (resolved via parliament_find_member). This is the canonical path for 'everything a member said in this debate' regardless of vocabulary — unlike text-search tools, it doesn't drop members who spoke without using a searched phrase. Omitting member_id returns every contribution (~100-200 for a long debate).",
      "parameters": {
        "type": "object",
        "properties": {
          "debate_ext_id": {
            "type": "string",
            "description": "Debate GUID, chained from parliament_search_hansard or parliament_lookup_by_column results"
          },
          "member_id": {
            "type": "integer",
            "description": "Optional — only that member's contributions are returned when given"
          }
        },
        "required": [
          "debate_ext_id"
        ]
      }
    }
  },
  {
    "type": "function",
    "persona": "legal_uk",
    "function": {
      "name": "parliament_lookup_by_column",
      "description": "Resolve an OSCOLA-style Hansard citation (column + volume + house), e.g. 'HL Deb 14 Oct 2025, vol 849, col 200', to its debate. volume_number is required — sitting date alone will not resolve it. An empty match list usually means the volume number is wrong (opposing counsel sometimes cites the running volume rather than the bound volume).",
      "parameters": {
        "type": "object",
        "properties": {
          "column_number": {
            "type": "string",
            "description": "Hansard column number from an OSCOLA footnote, e.g. '200' or '1162W' for written answers"
          },
          "volume_number": {
            "type": "integer",
            "description": "Hansard volume number — required, sitting date is not a substitute"
          },
          "house": {
            "type": "string",
            "description": "'Commons', 'Lords', or 'both' (default)"
          }
        },
        "required": [
          "column_number",
          "volume_number"
        ]
      }
    }
  },
