  {
    "type": "function",
    "persona": "legal_uk",
    "function": {
      "name": "committees_search_evidence",
      "description": "Fetch oral and written evidence submitted to a select committee by committee_id. Returns one page (default 20) — paginate with offset while has_more is true.",
      "parameters": {
        "type": "object",
        "properties": {
          "committee_id": {
            "type": "integer",
