[
  {
    "type": "function",
    "function": {
      "name": "search_jurisprudence",
      "description": "Semantic search over Philippine Supreme Court decisions via juris.ph. Use for case law, doctrines, holdings, and G.R. number discovery. Then call get_case before stating a holding.",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Natural-language legal question, facts, or doctrine to search"
          },
          "limit": {
            "type": "integer",
            "description": "Max results (1-20, default 5)"
          },
          "year": {
            "type": "integer",
            "description": "Optional: only decisions promulgated in this year"
          },
          "case_type": {
            "type": "string",
            "description": "Optional filter, e.g. Criminal, Civil, Administrative, Labor"
          }
        },
        "required": [
          "query"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "search_republic_acts",
      "description": "Semantic search over Philippine Republic Acts via juris.ph. Use for statutes and policy areas. Then call get_republic_act before stating what an RA requires.",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Natural-language subject matter or policy area"
          },
          "limit": {
            "type": "integer",
            "description": "Max results (1-20, default 5)"
          },
          "year": {
            "type": "integer",
            "description": "Optional: only acts enacted in this year"
          }
        },
        "required": [
          "query"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_case",
      "description": "Fetch the structured record of one Supreme Court decision by juris.ph id or case number (e.g. G.R. No. 254972). Required before stating a holding. Set include_full_text only when quoting exact language or the user asks for the full decision.",
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Document id from a search_jurisprudence result"
          },
          "case_number": {
            "type": "string",
            "description": "Official case number, e.g. G.R. No. 254972"
          },
          "include_full_text": {
            "type": "boolean",
            "description": "Also return the complete decision text (long). Default false."
          }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_republic_act",
      "description": "Fetch the structured record of one Republic Act by juris.ph id or RA number (e.g. RA 11313). Required before stating what the act requires. Set include_full_text only when quoting exact language or the user asks for the full act.",
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Document id from a search_republic_acts result"
          },
          "ra_number": {
            "type": "string",
            "description": "RA number, e.g. RA 11313 or 11313"
          },
          "include_full_text": {
            "type": "boolean",
            "description": "Also return the complete act text (long). Default false."
          }
        }
      }
    }
  },
  {
    "type": "function",
    "persona": "legal",
    "function": {
      "name": "get_case_document",
      "description": "Fetch a case document the user has uploaded to their own case in ilovelawyer (e.g. a contract, pleading, or other case file). This is the user's own private material, NOT public jurisprudence — never cite it as a Legal Citation or treat it as precedent. Call this when the conversation references a specific case_document_id, or when the user asks about a document they've attached to their case.",
      "parameters": {
        "type": "object",
        "properties": {
          "case_document_id": {
            "type": "string",
            "description": "The case document's id"
          },
          "case_document_chunk_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional — restrict to this specific set of chunk ids instead of the whole document."
          }
        },
        "required": [
          "case_document_id"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_legal_recommendation",
      "description": "Get legal information and recommendations for a Philippine legal question. Use when user asks about laws, rights, penalties, or legal procedures.",
      "parameters": {
        "type": "object",
        "properties": {
          "legal_issue": {
            "type": "string",
            "description": "The legal question or issue to research"
          },
          "user_context": {
            "type": "string",
            "description": "Optional context about the user's specific situation"
          }
        },
        "required": [
          "legal_issue"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "analyze_document",
      "description": "Download and analyze a legal document from S3. Call this when the user has uploaded a document and wants it analyzed. Returns a full structured Philippine legal analysis with 7 sections.",
      "parameters": {
        "type": "object",
        "properties": {
          "s3_key": {
            "type": "string",
            "description": "The S3 key of the uploaded document (e.g. 'uploads/documents/uuid-filename.pdf')"
          },
          "filename": {
            "type": "string",
            "description": "Optional display filename for the document"
          }
        },
        "required": [
          "s3_key"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "scan_cosmetic",
      "description": "Analyze a cosmetic product by scanning its front and back label images stored in S3. Returns a per-ingredient breakdown (function, safety concern, skin-type verdict) and a markdown summary. Call this when the user uploads cosmetic product photos.",
      "parameters": {
        "type": "object",
        "properties": {
          "front_s3_key": {
            "type": "string",
            "description": "S3 key of the front label image (e.g. 'uploads/cosmetics/uuid-front.jpg')"
          },
          "back_s3_key": {
            "type": "string",
            "description": "S3 key of the back label image containing the printed ingredient list"
          },
          "skin_type": {
            "type": "string",
            "enum": [
              "oily",
              "dry",
              "sensitive",
              "combination",
              "general"
            ],
            "description": "User's skin type for personalized ingredient verdicts. Defaults to 'general'."
          }
        },
        "required": [
          "back_s3_key"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "match_cosmetics",
      "description": "Check whether two cosmetic products are compatible to use together. Takes the ingredient lists from two prior scan results and the user's skin type. Returns a compatibility verdict (safe/caution/avoid), a list of ingredient conflicts with severity, and a markdown summary with usage recommendations.",
      "parameters": {
        "type": "object",
        "properties": {
          "product_a_name": {
            "type": "string",
            "description": "Name of the first product"
          },
          "product_a_ingredients": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Ingredients array from the first product's scan result"
          },
          "product_b_name": {
            "type": "string",
            "description": "Name of the second product"
          },
          "product_b_ingredients": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Ingredients array from the second product's scan result"
          },
          "skin_type": {
            "type": "string",
            "enum": [
              "oily",
              "dry",
              "sensitive",
              "combination",
              "general"
            ],
            "description": "User's skin type for personalized conflict assessment. Defaults to 'general'."
          }
        },
        "required": [
          "product_a_name",
          "product_a_ingredients",
          "product_b_name",
          "product_b_ingredients"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "generate_legal_document",
      "description": "Generate a Philippine legal document. Supported types: affidavit_of_loss, demand_letter, power_of_attorney, authorization_letter, promissory_note, lease_contract.",
      "parameters": {
        "type": "object",
        "properties": {
          "document_type": {
            "type": "string",
            "enum": [
              "affidavit_of_loss",
              "demand_letter",
              "power_of_attorney",
              "authorization_letter",
              "promissory_note",
              "lease_contract"
            ],
            "description": "Type of legal document to generate"
          },
          "affiant_name": {
            "type": "string",
            "description": "For affidavit_of_loss: full name of affiant"
          },
          "item_lost": {
            "type": "string",
            "description": "For affidavit_of_loss: description of lost item"
          },
          "date_lost": {
            "type": "string",
            "description": "For affidavit_of_loss: date when item was lost"
          },
          "circumstances": {
            "type": "string",
            "description": "For affidavit_of_loss: how the item was lost"
          },
          "sender_name": {
            "type": "string",
            "description": "For demand_letter: sender full name"
          },
          "recipient_name": {
            "type": "string",
            "description": "For demand_letter: recipient full name"
          },
          "amount": {
            "type": "string",
            "description": "For demand_letter/promissory_note: amount in PHP"
          },
          "reason": {
            "type": "string",
            "description": "For demand_letter: reason for demand"
          },
          "deadline_days": {
            "type": "integer",
            "description": "For demand_letter: days to comply"
          },
          "principal_name": {
            "type": "string",
            "description": "For power_of_attorney: principal (grantor) name"
          },
          "attorney_name": {
            "type": "string",
            "description": "For power_of_attorney: attorney-in-fact name"
          },
          "powers_granted": {
            "type": "string",
            "description": "For power_of_attorney: powers being granted"
          },
          "authorizer_name": {
            "type": "string",
            "description": "For authorization_letter: authorizer full name"
          },
          "authorized_person": {
            "type": "string",
            "description": "For authorization_letter: authorized person's name"
          },
          "purpose": {
            "type": "string",
            "description": "For authorization_letter: purpose of authorization"
          },
          "borrower_name": {
            "type": "string",
            "description": "For promissory_note: borrower full name"
          },
          "lender_name": {
            "type": "string",
            "description": "For promissory_note: lender full name"
          },
          "principal_amount": {
            "type": "string",
            "description": "For promissory_note: loan amount"
          },
          "due_date": {
            "type": "string",
            "description": "For promissory_note: payment due date"
          },
          "lessor_name": {
            "type": "string",
            "description": "For lease_contract: landlord full name"
          },
          "lessee_name": {
            "type": "string",
            "description": "For lease_contract: tenant full name"
          },
          "property_address": {
            "type": "string",
            "description": "For lease_contract: property address"
          },
          "monthly_rent": {
            "type": "string",
            "description": "For lease_contract: monthly rent amount"
          },
          "lease_term": {
            "type": "string",
            "description": "For lease_contract: lease duration (e.g. '1 year')"
          }
        },
        "required": [
          "document_type"
        ]
      }
    }
  },
  {
    "type": "function",
    "persona": "stylist",
    "function": {
      "name": "navigate_app",
      "description": "Navigate the user to a specific page in the app. Call this ONLY when the user explicitly asks to go somewhere (not for outfit or cosmetics requests). Pick the exact target_url from the sitemap table in your instructions. Do not invent URLs.",
      "parameters": {
        "type": "object",
        "properties": {
          "target_url": {
            "type": "string",
            "description": "The exact URL path from the sitemap table, e.g. '/ai-recommendation-fashion'. Must match a route in the table exactly."
          }
        },
        "required": [
          "target_url"
        ]
      }
    }
  },
  {
    "type": "function",
    "persona": "stylist",
    "function": {
      "name": "get_outfits_by_category",
      "description": "Fetch outfits from the catalogue filtered by a specific category and gender. Use this when the user selects a category (e.g. 'Casual', 'Formal', 'Streetwear'). Returns all matching outfits directly — no AI selection. Pass weather_json when available so hot-weather outerwear is excluded.",
      "parameters": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "description": "Outfit category to filter by — pass the value exactly as received (e.g. 'Casual', 'Formal', 'Streetwear', 'Business', 'Athleisure')."
          },
          "gender": {
            "type": "string",
            "enum": [
              "MALE",
              "FEMALE"
            ],
            "description": "User's gender for filtering outfits. Required — ask the user if not known."
          },
          "weather_json": {
            "type": "string",
            "description": "Pass the [FRONTEND_WEATHER:{...}] JSON string exactly as received. Used to filter out weather-inappropriate outfits (e.g. heavy jackets when it's hot). Optional."
          }
        },
        "required": [
          "category",
          "gender"
        ]
      }
    }
  },
  {
    "type": "function",
    "persona": "garment",
    "function": {
      "name": "recommend_garments",
      "description": "Recommend garments for a given event, weather, and gender. Call this when the user asks what to wear, needs outfit suggestions, or uses the [garment] prefix. Fetches live weather via Open-Meteo and a real garment catalogue to produce personalized, weather-aware outfit recommendations as JSON with reasons.",
      "parameters": {
        "type": "object",
        "properties": {
          "gender": {
            "type": "string",
            "enum": [
              "MALE",
              "FEMALE"
            ],
            "description": "User's gender for filtering garments. Required — ask the user if not stated."
          },
          "event_type": {
            "type": "string",
            "description": "Type of event or occasion described in natural language — e.g. 'formal dinner', 'casual day out', 'beach outing'. Used as context for the AI selection prompt. Use 'category' for structured API filtering instead."
          },
          "event_date": {
            "type": "string",
            "description": "Event date in YYYY-MM-DD format. Defaults to today if not provided."
          },
          "location": {
            "type": "string",
            "description": "User's location as a city name (e.g. 'Cebu City', 'BGC Taguig'), landmark, or 'lat,lon' coordinates. Defaults to Manila if not provided."
          },
          "sets": {
            "type": "integer",
            "description": "Number of distinct outfit sets to recommend. Defaults to 1. Maximum is 3. Each set has a unique vibe tied to local fashion trends. Infer from user prompt — e.g. 'give me 2 outfits' → sets=2."
          },
          "weather_json": {
            "type": "string",
            "description": "Pre-fetched weather data from the frontend as a JSON string. When the message contains [FRONTEND_WEATHER:{...}], extract that exact JSON string and pass it here verbatim. The function will skip internal weather fetching and use this data directly."
          },
          "category": {
            "type": "string",
            "description": "Outfit category to filter by, matching the outfit's metaData.category. Infer from the event or vibe the user describes — e.g. 'Formal', 'Casual', 'Streetwear', 'Smart Casual', 'Business', 'Party', 'Athleisure'. Omit if the user has no clear style preference."
          },
          "silhouette": {
            "type": "string",
            "description": "Outfit silhouette to filter by, matching metaData.silhouette. Use when the user expresses a fit or cut preference — e.g. 'Structured', 'Relaxed', 'Fitted', 'Oversized', 'Tailored'. Omit if unspecified."
          },
          "garment_type": {
            "type": "string",
            "description": "Specific garment type to include, matching metaData.garmentType — e.g. 'Jacket', 'Pants', 'Dress', 'TShirt', 'Shoes', 'Skirt'. Use when the user asks for an outfit built around a particular piece. Omit if not mentioned."
          },
          "tags": {
            "type": "string",
            "description": "Descriptive tag to narrow results, matching metaData.tags — e.g. 'wide leg pants', 'all white', 'monochrome', 'floral'. Use only when the user mentions a very specific descriptor. Omit if not applicable."
          }
        },
        "required": [
          "gender"
        ]
      }
    }
  },
  {
    "type": "function",
    "persona": "maps",
    "function": {
      "name": "search_nearby_places",
      "description": "Search for nearby places (restaurants, cafes, hospitals, ATMs, etc.) using Google Places API. Use when the user asks about places near their location or uses the [maps] prefix. Automatically routes between Nearby Search and Text Search based on query intent.",
      "parameters": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number",
            "description": "User's latitude. Extract from [USER_LOCATION:{...}] ONLY when searching near the user's current position. Omit (or pass 0) when location_name is provided â€” it will be ignored."
          },
          "lng": {
            "type": "number",
            "description": "User's longitude. Extract from [USER_LOCATION:{...}] ONLY when searching near the user's current position. Omit (or pass 0) when location_name is provided â€” it will be ignored."
          },
          "query": {
            "type": "string",
            "description": "What to search for, e.g. 'restaurant', 'coffee shop', 'ATM', 'hospital'. Infer from the user's message."
          },
          "radius": {
            "type": "integer",
            "description": "Search radius in meters. Default is 1500. Override if user specifies distance e.g. 'within 2km' -> 2000."
          },
          "location_name": {
            "type": "string",
            "description": "Named location(s) to search AT instead of the user's GPS. Single: 'La Union'. Multiple (comma-separated): 'SM Baguio, La Union, Vigan City'. REQUIRED when the user names a destination (e.g. 'meeting in La Union', 'going to Baguio'). When set, GPS lat/lng is ignored â€” the place is geocoded automatically."
          }
        },
        "required": [
          "query"
        ]
      }
    }
  },
  {
    "type": "function",
    "persona": "stylist",
    "function": {
      "name": "get_cosmetics_by_skin_type",
      "description": "Fetch cosmetic product recommendations by skin type. Use this when the user selects or states their skin type (e.g. 'Dry', 'Oily', 'Combination', 'Normal', 'Sensitive'). Returns a skin_type signal — mirror-api resolves the matching products directly.",
      "parameters": {
        "type": "object",
        "properties": {
          "skin_type": {
            "type": "string",
            "enum": [
              "DRY",
              "OILY",
              "COMBINATION",
              "NORMAL",
              "SENSITIVE"
            ],
            "description": "User's skin type — pass the value exactly as received. Valid values: DRY, OILY, COMBINATION, NORMAL, SENSITIVE."
          }
        },
        "required": [
          "skin_type"
        ]
      }
    }
  },
  {
    "type": "function",
    "persona": "cosmetics",
    "function": {
      "name": "recommend_cosmetics",
      "description": "Recommend a personalised skincare routine from the cosmetics catalogue based on a skin analysis result. Call this when the user asks for product recommendations, skincare advice, or uses the [cosmetics] prefix. Parses skin analysis scores to determine skin type and concerns, then curates routine sets from a live catalogue.",
      "parameters": {
        "type": "object",
        "properties": {
          "skin_analysis_json": {
            "type": "string",
            "description": "Skin analysis result as a JSON string. When the message contains [SKIN_ANALYSIS:{...}], extract that exact JSON string and pass it here verbatim. The function derives skin type and concerns from the scores automatically."
          },
          "sets": {
            "type": "integer",
            "description": "Number of distinct skincare routines to recommend. Defaults to 1. Maximum is 3. Each routine targets a different vibe or concern. Infer from user prompt — e.g. \"give me 2 routines\" -> sets=2."
          }
        },
        "required": []
      }
    }
  },
  {
    "type": "function",
    "persona": "tailor",
    "function": {
      "name": "generate_outfit_image",
      "description": "Generate a premium ghost mannequin outfit photograph from individual garment images. Call this immediately when the user wants to visualize selected garments as a complete outfit. Uses AI image generation to composite the garments onto an invisible mannequin with professional studio lighting.",
      "parameters": {
        "type": "object",
        "properties": {
          "garment_image_urls": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of image URLs for the selected garment items (top, bottom, shoes, etc.). Extract from [GARMENT_IMAGES:[...]] annotation in the message."
          },
          "gender": {
            "type": "string",
            "enum": [
              "MALE",
              "FEMALE"
            ],
            "description": "Mannequin gender for the generated outfit photo. Extract from [GENDER:MALE] or [GENDER:FEMALE] annotation in the message. Defaults to MALE."
          }
        },
        "required": [
          "garment_image_urls",
          "gender"
        ]
      }
    }
  },
  {
    "type": "function",
    "persona": "legal_uk",
    "function": {
      "name": "case_law_search",
      "description": "Search UK case law by party names, court, judge, date, or free-text query via the UK Legal MCP (TNA Find Case Law). Returns judgment summaries with a slug for judgment_get_header/index/paragraph. Coverage starts roughly early-2000s; for older authorities, search for a modern judgment quoting them. from_date/to_date are currently ignored upstream — do not rely on them to narrow results. judge filter is a case-insensitive surname substring match; appending honorifics like 'JSC' or 'KC' silently zeroes the results.",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Full-text search query, e.g. 'negligence duty of care'"
          },
          "court": {
            "type": "string",
            "description": "Optional court slug filter, e.g. 'uksc', 'ewca/civ', 'ewhc/kb', 'ukut/iac'"
          },
          "party": {
            "type": "string",
            "description": "Optional party name filter"
          },
          "judge": {
            "type": "string",
            "description": "Optional judge surname filter (case-insensitive substring, e.g. 'Reed'). Do not append honorifics like 'JSC' or 'KC'."
          },
          "limit": {
            "type": "integer",
            "description": "Max results (1-50, default 10)"
          },
          "page": {
            "type": "integer",
            "description": "Result page number, 1-indexed (default 1)"
          }
        },
        "required": [
          "query"
        ]
      }
    }
  },
  {
    "type": "function",
    "persona": "legal_uk",
    "function": {
      "name": "judgment_get_header",
      "description": "Fetch a UK judgment's metadata (parties, judges, neutral citation, court, dates) by slug. Call case_law_search first to get the slug.",
      "parameters": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "description": "Judgment slug, e.g. 'uksc/2024/12' or 'ewca/civ/2023/450'"
          }
        },
        "required": [
          "slug"
        ]
      }
    }
  },
  {
    "type": "function",
    "persona": "legal_uk",
    "function": {
      "name": "judgment_get_index",
      "description": "Fetch the paragraph navigation index (eId + preview line for every paragraph) of a UK judgment by slug. Use eIds with judgment_get_paragraph, or use case_law_grep_judgment to search by content instead.",
      "parameters": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "description": "Judgment slug, e.g. 'uksc/2024/12'"
          }
        },
        "required": [
          "slug"
        ]
      }
    }
  },
  {
    "type": "function",
    "persona": "legal_uk",
    "function": {
      "name": "judgment_get_paragraph",
      "description": "Fetch one paragraph's full text from a UK judgment by slug + eId. Call judgment_get_index first to discover eIds, or case_law_grep_judgment to locate them by content.",
      "parameters": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "description": "Judgment slug, e.g. 'uksc/2024/12'"
          },
          "eId": {
            "type": "string",
            "description": "Paragraph eId from judgment_get_index, e.g. 'para_12'"
          }
        },
        "required": [
          "slug",
          "eId"
        ]
      }
    }
  },
  {
    "type": "function",
    "persona": "legal_uk",
    "function": {
      "name": "case_law_grep_judgment",
      "description": "Search within one UK judgment for paragraphs matching a regex or substring pattern. Returns {eId, snippet, match} hits. Read full paragraphs via judgment_get_paragraph afterward.",
      "parameters": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "description": "Judgment slug, e.g. 'uksc/2024/12'"
          },
          "pattern": {
            "type": "string",
            "description": "Regex or plain substring to search for within paragraph text"
          },
          "case_insensitive": {
            "type": "boolean",
            "description": "Default true"
          },
          "max_hits": {
            "type": "integer",
            "description": "Cap on hits returned (default 25)"
          }
        },
        "required": [
          "slug",
          "pattern"
        ]
      }
    }
  },
  {
    "type": "function",
    "persona": "legal_uk",
    "function": {
      "name": "legislation_search",
      "description": "Search UK Acts and Statutory Instruments (legislation.gov.uk) by title or full text. type/year filters are exact-match — omit unless already known; guessing a year and getting it wrong zeroes the results. fulltext=false (default) searches titles only.",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search query, e.g. 'Housing Act 1988' or 'data protection personal data'"
          },
          "type": {
            "type": "string",
            "description": "Exact-match filter: 'ukpga' (Acts), 'uksi' (SIs), 'asp' (Scottish Acts), 'nia' (NI Acts). Omit if unsure."
          },
          "year": {
            "type": "integer",
            "description": "Exact-match year of enactment. Omit unless already known — query without it and read the year from results instead."
          },
          "fulltext": {
            "type": "boolean",
            "description": "Default false (titles only). Set true to search full text of every Act/SI."
          },
          "limit": {
            "type": "integer",
            "description": "Max results (1-50, default 20)"
          }
        },
        "required": [
          "query"
        ]
      }
    }
  },
  {
    "type": "function",
    "persona": "legal_uk",
    "function": {
      "name": "legislation_get_toc",
      "description": "Fetch the structural table of contents (parts, chapters, sections, schedules) of a UK Act or SI. Pass the numeric section id (e.g. '47', not 'section-47') into legislation_get_section for full text. Paginated for large statutes — check has_more/total_items.",
      "parameters": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Legislation type code from legislation_search results: 'ukpga', 'uksi', 'asp', 'nia'"
          },
          "year": {
            "type": "integer",
            "description": "Year of enactment"
          },
          "number": {
            "type": "integer",
            "description": "Chapter or SI number"
          },
          "offset": {
            "type": "integer",
            "description": "Items to skip, for paginating large statutes (default 0)"
          },
          "limit": {
            "type": "integer",
            "description": "Max items to return (default 200, max 1000)"
          }
        },
        "required": [
          "type",
          "year",
          "number"
        ]
      }
    }
  },
  {
    "type": "function",
    "persona": "legal_uk",
    "function": {
      "name": "legislation_get_section",
      "description": "Fetch the parsed text of one section of a UK Act or SI, with territorial extent and in-force status. ALWAYS check the returned extent — a section may apply to England & Wales but not Scotland or Northern Ireland; reciting it without checking extent is a common error. Content is capped at max_chars (default 10000); check content_truncated.",
      "parameters": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Legislation type code: 'ukpga', 'uksi', 'asp', 'nia'"
          },
          "year": {
            "type": "integer",
            "description": "Year of enactment"
          },
          "number": {
            "type": "integer",
            "description": "Chapter or SI number"
          },
          "section": {
            "type": "string",
            "description": "Section number, e.g. '47' or '12A' (numeric part only, not 'section-47')"
          },
          "max_chars": {
            "type": "integer",
            "description": "Max characters of content to return (default 10000, raise only for unusually long sections)"
          }
        },
        "required": [
          "type",
          "year",
          "number",
          "section"
        ]
      }
    }
  },
  {
    "type": "function",
    "persona": "legal_uk",
    "function": {
      "name": "citations_parse",
      "description": "Extract and classify every OSCOLA-style citation in free text (neutral citations, law reports, legislation sections, SIs, retained EU law). Pure regex by default; set disambiguate=true to let the calling model resolve ambiguous court codes (e.g. bare EWHC without a division) via MCP sampling.",
      "parameters": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Free text containing OSCOLA citations to extract (max 50,000 chars)"
          },
          "disambiguate": {
            "type": "boolean",
            "description": "Default false (pure regex, no model in the loop). Set true only to accept model-assisted division resolution for ambiguous citations."
          }
        },
        "required": [
          "text"
        ]
      }
    }
  },
  {
    "type": "function",
    "persona": "legal_uk",
    "function": {
      "name": "citations_resolve",
      "description": "Parse and resolve a single OSCOLA citation (neutral citation, SI, legislation section, retained EU law), returning parsed fields plus resolved_url. For neutral citations, performs a live check against The National Archives — confidence 0.0 means the document was not found there; do NOT format or quote a confidence-0.0 citation. Call this BEFORE constructing an OSCOLA citation string or citing a case.",
      "parameters": {
        "type": "object",
        "properties": {
          "citation": {
            "type": "string",
            "description": "A single OSCOLA citation to parse and resolve, e.g. '[2024] UKSC 12', 'SI 2018/1234', 's.47 Companies Act 2006'"
          }
        },
        "required": [
          "citation"
        ]
      }
    }
  },
  {
    "type": "function",
    "persona": "legal_uk",
    "function": {
      "name": "citations_network",
      "description": "Fetch every citation a UK judgment makes (cases cited, legislation, SIs, retained EU law referenced), grouped by type. Pass any result through citations_resolve to confirm it resolves and get its canonical URL.",
      "parameters": {
        "type": "object",
        "properties": {
          "case_uri": {
            "type": "string",
            "description": "TNA judgment URI slug from a case_law_search result's 'uri' field, e.g. 'uksc/2024/12' — do not include the https:// prefix"
          }
        },
        "required": [
          "case_uri"
        ]
      }
    }
  },
  {
    "type": "function",
    "persona": "legal_uk",
    "function": {
      "name": "citations_format_oscola",
      "description": "Produce a correctly formatted OSCOLA 4th-edition citation string from the structured fields returned by citations_resolve. Do NOT construct these fields yourself — always pass through citations_resolve's output verbatim; guessing fields is the primary citation-fabrication risk. Refuses to format (and must not be worked around) if confidence is 0.0 or a neutral citation has no resolved_url.",
      "parameters": {
        "type": "object",
        "properties": {
          "citation_type": {
            "type": "string",
            "description": "'type' field from citations_resolve result: 'neutral', 'law_report', 'legislation', 'si', or 'eu_retained'"
          },
          "confidence": {
            "type": "number",
            "description": "'confidence' field from citations_resolve — pass through exactly, never guess. 0.0 means refuse to format."
          },
          "court": {
            "type": "string",
            "description": "'court' from citations_resolve, e.g. 'UKSC', 'EWCA CIV'"
          },
          "year": {
            "type": "integer",
            "description": "'year' from citations_resolve"
          },
          "number": {
            "type": "integer",
            "description": "'number' from citations_resolve (judgment number within the year)"
          },
          "resolved_url": {
            "type": "string",
            "description": "'resolved_url' from citations_resolve — required for neutral citations"
          },
          "report_series": {
            "type": "string",
            "description": "'report_series' from citations_resolve, e.g. 'WLR', 'AC', 'QB'"
          },
          "volume": {
            "type": "integer",
            "description": "'volume' from citations_resolve (law report volume)"
          },
          "page": {
            "type": "integer",
            "description": "'page' from citations_resolve (starting page in the law report)"
          },
          "legislation_title": {
            "type": "string",
            "description": "'legislation_title' from citations_resolve, e.g. 'Companies Act 2006'"
          },
          "section": {
            "type": "string",
            "description": "'section' from citations_resolve, e.g. '47', '12', '20A'"
          },
          "si_year": {
            "type": "integer",
            "description": "'si_year' from citations_resolve"
          },
          "si_number": {
            "type": "integer",
            "description": "'si_number' from citations_resolve"
          },
          "raw": {
            "type": "string",
            "description": "'raw' from citations_resolve — used as-is for EU retained law"
          }
        },
        "required": [
          "citation_type",
          "confidence"
        ]
      }
    }
  },
  {
    "type": "function",
    "persona": "legal_uk",
    "function": {
      "name": "parliament_search_hansard",
      "description": "Search Hansard debate contributions by phrase, date range, house, or member. query must be words a member actually said, not a bill title (members rarely say the full title verbatim). Chain: read the debate via parliament_get_debate_contributions(debate_ext_id). To filter by member, resolve member_id via parliament_find_member first.",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Phrase to find in Hansard contribution text, e.g. 'disproportionate sanction' — tokens a member would say, not a bill title"
          },
          "house": {
            "type": "string",
            "description": "'Commons', 'Lords', or 'both' (default)"
          },
          "from_date": {
            "type": "string",
            "description": "Start date YYYY-MM-DD"
          },
          "to_date": {
            "type": "string",
            "description": "End date YYYY-MM-DD"
          },
          "member_id": {
            "type": "integer",
            "description": "Filter to one member's contributions — get the integer id from parliament_find_member first"
          },
          "contribution_type": {
            "type": "string",
            "description": "'Spoken' (default), 'Written', or 'Corrections'"
          },
          "text_mode": {
            "type": "string",
            "description": "'preview' (default, short snippet) or 'full' (still capped at 3000 chars)"
          },
          "limit": {
            "type": "integer",
            "description": "Max contributions (1-100, default 20)"
          },
          "offset": {
            "type": "integer",
            "description": "Pagination offset (default 0)"
          }
        },
        "required": [
          "query"
        ]
      }
    }
  },
  {
    "type": "function",
    "persona": "legal_uk",
    "function": {
      "name": "parliament_policy_position_summary",
      "description": "Aggregate Hansard debate-level signals on a topic (by house, year, month, section) without reading every contribution — pure counts, no editorial labels. Pick a debate from top_debates and pass its debate_ext_id into parliament_get_debate_contributions to drill in.",
      "parameters": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "description": "Phrase to aggregate on — a bill title works here even though it wouldn't for parliament_search_hansard, since this tool also matches debate titles/metadata"
          },
          "house": {
            "type": "string",
            "description": "'Commons', 'Lords', or 'both' (default)"
          },
          "from_date": {
            "type": "string",
            "description": "Start date YYYY-MM-DD"
          },
          "to_date": {
            "type": "string",
            "description": "End date YYYY-MM-DD"
          },
          "max_debates_scanned": {
            "type": "integer",
            "description": "Cap on debates sampled to compute facets (default 200, max 2000)"
          }
        },
        "required": [
          "topic"
        ]
      }
    }
  },
  {
    "type": "function",
    "persona": "legal_uk",
    "function": {
      "name": "parliament_find_member",
      "description": "Look up a Member of Parliament or Lord by name to get their integer member_id, party, constituency, and house. Call this BEFORE any tool that filters by member_id (parliament_get_debate_contributions, parliament_member_debates, parliament_member_interests). Text-searching by name in other tools returns unrelated results.",
      "parameters": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name or partial name, e.g. 'Starmer' or 'Baroness Hale'"
          }
        },
        "required": [
          "name"
        ]
      }
    }
  },
  {
    "type": "function",
    "persona": "legal_uk",
    "function": {
      "name": "parliament_member_debates",
      "description": "Find contributions where a specific member used a topic phrase verbatim (text-body search) — call parliament_find_member first to get member_id. For every contribution by that member in a known debate regardless of vocabulary, use parliament_get_debate_contributions(debate_ext_id, member_id=...) instead.",
      "parameters": {
        "type": "object",
        "properties": {
          "member_id": {
            "type": "integer",
            "description": "Parliament Members API integer id, from parliament_find_member"
          },
          "topic": {
            "type": "string",
            "description": "Optional phrase this member would have said verbatim — not a bill title"
          },
          "limit": {
            "type": "integer",
            "description": "Max contributions (default 20)"
          },
          "offset": {
            "type": "integer",
            "description": "Pagination offset (default 0)"
          }
        },
        "required": [
          "member_id"
        ]
      }
    }
  },
  {
    "type": "function",
    "persona": "legal_uk",
    "function": {
      "name": "parliament_member_interests",
      "description": "Fetch a member's registered financial interests (donations, directorships, land, gifts) — call parliament_find_member first to get member_id. Hard-capped at 20 results per call by the upstream API regardless of limit; paginate via offset for prolific members.",
      "parameters": {
        "type": "object",
        "properties": {
          "member_id": {
            "type": "integer",
            "description": "Parliament Members API integer id, from parliament_find_member"
          },
          "category": {
            "type": "string",
            "description": "Optional filter: 'donations', 'gifts_uk', 'employment', 'land', 'shareholdings', 'overseas_visits', etc. Omit for all categories."
          },
          "limit": {
            "type": "integer",
            "description": "Max interests per call (hard-capped at 20 upstream regardless of value)"
          },
          "max_description_chars": {
            "type": "integer",
            "description": "Per-entry cap on free-text description (default 500)"
          },
          "offset": {
            "type": "integer",
            "description": "Pagination offset for prolific members (default 0)"
          }
        },
        "required": [
          "member_id"
        ]
      }
    }
  },
  {
